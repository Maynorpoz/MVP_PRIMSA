DATABASE_URL=postgresql+psycopg2://primsa:primsa@postgres_db:5432/primsa
SECRET_KEY=change-this-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origin(s) allowed to call this API (comma-separated). Must be the
# frontend's own origin(s), not the backend's.
CORS_ORIGINS=http://localhost:5173

# Optional: seeds the first sales_admin_role account on startup (skipped if
# unset, or if a user with this email already exists). Leave both unset in
# normal operation; further admins are created via POST /access/admins.
FIRST_ADMIN_EMAIL=admin@primsa.com  
FIRST_ADMIN_PASSWORD=mynorpoz123
